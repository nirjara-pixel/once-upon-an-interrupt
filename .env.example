# Copy to .env and fill in real values. NEVER commit .env.
GITHUB_TOKEN=not_needed_at_runtime
FISH_AUDIO_API_KEY=replace_me
HUGGINGFACE_API_KEY=replace_me
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Fish.audio TTS model header value. Run scripts/smoke_test_fish.py to find
# which model your key supports (e.g. s1, speech-1.5, speech-2.5-pro).
FISH_TTS_MODEL=s1
# "Sarah" — default narrator voice: Fish marketplace "Gentle Hindi Female"
# (Hindi + English, Indian accent). Cloned voices override this per session.
FISH_DEFAULT_VOICE_ID=fc53c5a8a3fd4e2aaa1d4b7eded7ef3f
APP_ENV=development
