# Copy to .env and fill in real values. NEVER commit .env.
GITHUB_TOKEN=not_needed_at_runtime
FISH_AUDIO_API_KEY=replace_me
HUGGINGFACE_API_KEY=replace_me
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Optional but recommended: Groq free tier (console.groq.com) — much lower
# latency than HF; if set, it is tried before Hugging Face.
GROQ_API_KEY=replace_me
GROQ_MODEL=llama-3.1-8b-instant
# Fish.audio TTS model header value. "s2.1-pro-free" is Fish's free S2.1 Pro
# promo tier (no credits needed, fair-use limits, no SLA). Paid keys can use
# s1 / speech-2.5-pro etc. Run scripts/smoke_test_fish.py to check yours.
FISH_TTS_MODEL=s2.1-pro-free
# "Sarah" — default narrator voice: Fish marketplace "Gentle Hindi Female"
# (Hindi + English, Indian accent). Cloned voices override this per session.
FISH_DEFAULT_VOICE_ID=fc53c5a8a3fd4e2aaa1d4b7eded7ef3f
APP_ENV=development
